# =========================================================
# PHARMA FIT — configuração do servidor (Hostinger / Apache)
# =========================================================

# ---- acentuação ------------------------------------------
# Sem isto o servidor manda ISO-8859-1, que vence o
# <meta charset="utf-8"> da página e quebra todo acento
# ("saúde" vira "saÃºde").
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .webmanifest .svg .txt .xml
</IfModule>

# ---- HTTPS obrigatório -----------------------------------
# As notificações do painel só funcionam em HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- tipos de arquivo ------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml             .svg
  AddType text/css                  .css
  AddType application/javascript    .js
</IfModule>

# ---- arquivos de projeto não são para o navegador --------
<FilesMatch "\.(sql|ts|md|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 404 ^/gestao/supabase/.*$
RedirectMatch 404 ^/\.git.*$

# ---- o service worker precisa valer para toda a pasta ----
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# ---- cache e compressão ----------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml        "access plus 1 month"
  ExpiresByType text/css             "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ---- páginas -------------------------------------------
DirectoryIndex index.html

ErrorDocument 404 /404.html

# -Indexes: ninguém vê a lista de arquivos de uma pasta.
# -MultiViews: o Apache não pode servir "dashboard.js" quando
#              o pedido era "dashboard" ou "dashboard.html".
Options -Indexes -MultiViews
