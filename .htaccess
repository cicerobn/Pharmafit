# =========================================================
# PHARMA FIT — configuração do servidor (Hostinger / Apache)
# =========================================================

# ---- acentuação ------------------------------------------
# Sem isto o servidor manda ISO-8859-1, que vence o
# <meta charset="utf-8"> da página e quebra todo acento
# ("saúde" vira "saÃºde").
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .json .webmanifest .svg .txt .xml
</IfModule>

# ---- HTTPS obrigatório -----------------------------------
# As notificações do painel só funcionam em HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- proteção contra gente mal-intencionada (24/09/2026) --
# Brian: "deixar o site seguro contra pessoas mal intencionadas".
#  · nosniff: o navegador não "adivinha" que um arquivo é script.
#  · SAMEORIGIN: nenhum site de fora consegue abrir o nosso dentro de
#    uma moldura invisível para enganar o clique (clickjacking) — o
#    golpe clássico contra o painel.
#  · Referrer: sites de fora não recebem o endereço completo de onde
#    a pessoa veio (ex.: "gestao/cliente.html?c=Nome do Cliente").
#  · Permissions: câmera, microfone e localização desligados — o site
#    não usa nenhum dos três, então nenhum script pode pedi-los.
#  · HSTS: depois da primeira visita o navegador só aceita HTTPS,
#    e ninguém no meio do Wi-Fi rebaixa a conexão para HTTP.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ---- tipos de arquivo ------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml             .svg
  AddType text/css                  .css
  AddType application/javascript    .js
</IfModule>

# ---- arquivos de projeto não são para o navegador --------
#
# `sh` entrou em 16/09/2026: o script da conferência do site saiu de dentro
# do YAML e virou arquivo (.github/conferir-no-ar.sh), porque dentro do YAML
# ele havia batido no tamanho que o GitHub consegue ler. Arquivo do
# repositório é servido pela hospedagem até alguém dizer que não.
<FilesMatch "\.(sql|ts|md|yml|yaml|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# As ferramentas de publicação não são para o navegador, e estavam sendo
# servidas. `conferir-tabelas.mjs` é a pior delas: ele lista os nomes das
# tabelas dos outros negócios deste mesmo banco. Com RLS em todas, não era
# buraco — era entregar o mapa de graça.
#
# Esta linha listava as ferramentas pelo NOME, uma por uma. Lista escrita à mão
# envelhece: hoje nasceu `conferir-css.mjs` e eu quase esqueci de somar ele
# aqui — e já é a terceira lista à mão que apodrece neste projeto.
#
# Agora a regra é pela FORMA: `.mjs` solto na raiz. Toda ferramenta mora na
# raiz e nenhum pedaço do site mora lá — o site é `assets/`, e a loja montada
# é `loja/`. É para isso que serve o `[^/]+`: ele casa só com a raiz e deixa
# `/loja/` em paz, que era justamente o motivo de eu não ter usado `\.mjs$`
# puro. A loja é montada, e no dia em que a montagem gerar um `.mjs` ela
# continua sendo servida.
#
# Ferramenta nova fica protegida sozinha, sem ninguém precisar lembrar.
RedirectMatch 404 ^/[^/]+\.mjs$
RedirectMatch 404 ^/gestao/supabase/.*$

# A pasta loja-fonte é o CÓDIGO da loja, não a loja. Ela vem no repositório
# porque a publicação monta a loja a partir dela — mas ninguém tem o que fazer
# baixando src/App.jsx do site. Mesmo bloqueio que já vale para o schema do
# banco logo acima, e provado funcionando pela conferência automática.
RedirectMatch 404 ^/loja-fonte/.*$
RedirectMatch 404 ^/\.git.*$

# ---- o service worker precisa valer para toda a pasta ----
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/"
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

# ---- cache e compressão ----------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml        "access plus 1 month"
  ExpiresByType text/css             "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ---- páginas -------------------------------------------
DirectoryIndex index.html

ErrorDocument 404 /404.html

# -Indexes: ninguém vê a lista de arquivos de uma pasta.
# -MultiViews: o Apache não pode servir "dashboard.js" quando
#              o pedido era "dashboard" ou "dashboard.html".
Options -Indexes -MultiViews
